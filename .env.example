# Tolani Corp Portal - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SMTP Configuration (Required for Contact Form)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact form recipients
CONTACT_TO=contact@tolanicorp.us
CONTACT_FROM=noreply@tolanicorp.us

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://tolanicorp.us

# ===========================================
# Analytics (Optional)
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===========================================
# Clerk Authentication (Required for Employee Portal)
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# ===========================================
# Convex Backend (Auto-generated by `npx convex dev`)
# ===========================================
# CONVEX_DEPLOYMENT=dev:your-deployment
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ===========================================
# CMS Integration (Optional - for future use)
# ===========================================
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=
