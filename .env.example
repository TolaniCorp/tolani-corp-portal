# Tolani Corp Portal - Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SMTP Configuration (Required for Contact Form)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Contact form recipients
CONTACT_TO=contact@tolanicorp.us
CONTACT_FROM=noreply@tolanicorp.us

# ===========================================
# Site Configuration
# ===========================================
NEXT_PUBLIC_SITE_URL=https://tolanicorp.us

# ===========================================
# Analytics (Optional)
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ===========================================
# CMS Integration (Optional - for future use)
# ===========================================
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_TOKEN=
